LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Local NVIDIA Tortoise TTS (default). Run scripts/setup-tortoise.ps1 once.
TTS_PROVIDER=tortoise
# TORTOISE_PYTHON=C:\Users\your-user\AppData\Local\WhiteboardStudio\tortoise\.venv\Scripts\python.exe
# TORTOISE_MODELS_DIR=C:\Users\your-user\AppData\Local\WhiteboardStudio\tortoise\models
# TORTOISE_VOICE=random
# TORTOISE_PRESET=ultra_fast
# TORTOISE_VOICE_DIR=C:\Users\your-user\AppData\Local\WhiteboardStudio\tortoise\voices
# TORTOISE_DOWNLOAD_TIMEOUT=600
# Legacy hosted adapter only; no longer required for the default workflow.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# Required for any public deployment. This creates a private studio sign-in;
# keep it long, random, and server-only.
STUDIO_ACCESS_TOKEN=
# Hosted editor only: proxy every project/API request to a persistent worker.
# Set the same high-entropy WORKER_SHARED_SECRET on the editor and worker;
# never use a NEXT_PUBLIC_ prefix for either setting.
# RENDER_WORKER_URL=https://worker.example.com
# WORKER_SHARED_SECRET=
# Optional: point FFMPEG_PATH at a current, trusted local FFmpeg build for production.
# FFMPEG_PATH=
# Optional PocketBase mirror for private project/source/editorial metadata.
# PocketBase itself must run on a persistent host, never in a serverless function.
# POCKETBASE_URL=https://pocketbase.example.com
# POCKETBASE_SUPERUSER_TOKEN=
# POCKETBASE_OWNER_ID=
# POCKETBASE_PROJECT_COLLECTION=studio_projects
